# Execute pnpm run setup para gerar .env.local com credenciais únicas.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Em produção, HTTPS e URL pública exata são obrigatórios.
APP_ORIGIN=http://127.0.0.1:3010
# local (padrão) ou s3. Local requer volume persistente e uma instância.
STORAGE_DRIVER=local
DATA_DIR=./data
# Configuração opcional de S3/MinIO, independente de grupoFood.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=loja-de-roupas/
# Apenas se proxy confiável sobrescrever x-forwarded-for.
TRUST_PROXY=false
